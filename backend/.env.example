# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=brigadnikos
DATABASE_USER=brigadnikos
DATABASE_PASSWORD=brigadnikos_dev_password
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change_this_to_a_very_secure_random_string_in_production
JWT_REFRESH_SECRET=change_this_to_another_very_secure_random_string
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for sensitive data like birth_number, bank_account)
ENCRYPTION_KEY=change_this_to_a_32_character_key_for_aes256

# Email (SendGrid, AWS SES, or similar)
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=noreply@brigadnikos.cz
SENDGRID_API_KEY=

# SMS (Twilio or similar)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# File Upload (AWS S3 or similar)
STORAGE_PROVIDER=s3
AWS_S3_BUCKET=brigadnikos-uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# ČSSZ Export
CSSZ_VPDPP_VERSION=1.0

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

# Logging
LOG_LEVEL=debug
